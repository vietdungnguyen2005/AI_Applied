+      const profiles=await loadIntegrationProfiles();
+      const found=profiles.map(p=>ProfileSummary.safeParse(p)).filter(p=>p.success).map(p=>p.data).find(p=>p.profileId===attempt?.profileId&&p.version===attempt?.version);
