+
+it("aborts a hanging upstream at the outer deadline without continuing a privileged loop", async () => {
+  vi.useFakeTimers();
+  try {
+    vi.stubEnv("AI_COPILOT_ENABLED", "true"); vi.stubEnv("BACKEND_ORIGIN", "http://127.0.0.1:8080");
