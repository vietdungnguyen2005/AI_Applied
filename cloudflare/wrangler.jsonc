    }
  ],
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "vars": {
    "PUBLIC_KEYS_JSON": "{\"cloud-20261103\":\"Uc/mAVuIqmUKa/eTJNpm81y1UibNtL0AnkqZFiwYR1U=\"}"
  }
}
