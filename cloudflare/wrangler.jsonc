{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vmarket-ai-applied",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "keep_vars": true,
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
