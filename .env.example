PERSONAL_ACCESS_TOKEN=
VYCEAI_API=
OPENROUTER_API=

# Fake default: no external requests. These settings never enter the browser.
AI_MODE=standalone
AI_BIND_HOST=127.0.0.1
AI_PORT=8090
AI_PROVIDER_MODE=fake
AI_DATABASE_URL=sqlite+pysqlite:///.local/ai.db
AI_LIVE_ENABLED=false
AI_LIVE_REQUEST_USD=0
AI_LIVE_DAILY_USD=0
AI_LIVE_DAILY_REQUESTS=10
# Optional migration-only URL stays out of the application process.
# AI_MIGRATION_DATABASE_URL=

# P07 is OFF by default. Enabling QA requires the isolated AI PostgreSQL database.
AI_QA_ENABLED=false
AI_QA_EMBEDDING_MODE=fake
# Real local retrieval additionally requires the ignored pinned model bundle directory:
# AI_QA_MODEL_BUNDLE=.local/models/multilingual-e5-small

# Optional host-only Ollama chat; no API key/budget needed (QA still requires PostgreSQL/E5).
# AI_PROVIDER_MODE=local
# AI_OLLAMA_MODEL=qwen3.5:4b-q4_K_M
# AI_OLLAMA_CONTEXT=4096
# AI_OLLAMA_TIMEOUT_SECONDS=25
# AI_REQUEST_DEADLINE_SECONDS=30

# P08 draft-only mapping route; fake/local providers only, requires AI PostgreSQL.
AI_MAPPING_ENABLED=false

# P09 read-only agent is OFF by default. Integrated mode exposes only signed step/search.
AI_AGENT_ENABLED=false
# JSON key ID -> base64 RAW 32-byte Ed25519 public key (never a private/Java key).
AI_GATEWAY_PUBLIC_KEYS={}
