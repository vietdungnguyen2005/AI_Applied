# Preserve provider/tool output and the supplied prompt package as evidence.
docs/evidence/logs/*.log -text -whitespace
docs/implementation-prompts.md -text -whitespace
data/specs/** text eol=lf
data/releases/** text eol=lf
# Frozen fixture bytes must survive Windows/Linux checkouts unchanged.
data/v1/** -text -whitespace
data/v1/csv/** -diff
evals/** text eol=lf
evals/onboarding-time/**/*.png -text -diff
# Blind-review copies preserve the exact CP932/UTF-8 source bytes and line endings.
evals/p13/mapping-review-v1/inputs/*.csv -text -diff

# Preserve reviewable cross-repository patch bytes and diff context whitespace.
docs/integration/*.patch -text -whitespace
